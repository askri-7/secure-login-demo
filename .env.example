# ── Docker Compose Variables ──
DOCKERHUB_USERNAME=your-dockerhub-username
IMAGE_TAG=latest

# Azure deployment uses the immutable SHA tag produced by Application image CI/CD.
# ACR_LOGIN_SERVER=yourregistry.azurecr.io
# BACKEND_IMAGE_NAME=backend
# IMAGE_TAG=the-application-git-sha

# ── Local PostgreSQL, development only ──
DB_USER=postgres
DB_PASSWORD=development-only-password
DB_NAME=authdb

# ── Azure production, no PostgreSQL password ──
# DB_HOST=example.postgres.database.azure.com
# DB_PORT=5432
# DB_NAME=authdb
# DB_PRINCIPAL=app-managed-identity-name
# AZURE_KEY_VAULT_URL=https://example.vault.azure.net/