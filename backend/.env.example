
# Database

# Local development database only. Production uses DB_AUTH_MODE=entra and no DATABASE_URL.
DB_AUTH_MODE=password
DATABASE_URL=postgresql://postgres:development-only-password@localhost:5433/authdb

# Azure production database configuration
# DB_AUTH_MODE=entra
# DB_HOST=example.postgres.database.azure.com
# DB_PORT=5432
# DB_NAME=authdb
# DB_PRINCIPAL=app-managed-identity-name
# DB_SSL_REJECT_UNAUTHORIZED=false
# JWT
JWT_SECRET=
# port

PORT = 3000

NODE_ENV = 

FRONTEND_URL = 
API_URL = 

GITHUB_CLIENT_ID= 
GITHUB_CLIENT_SECRET= 
GITHUB_CALLBACK_URL= 

GOOGLE_CLIENT_ID= 
GOOGLE_CLIENT_SECRET= 
GOOGLE_CALLBACK_URL= 


# Database pool settings

DB_POOL_MAX=20
DB_TIMEOUT=10000
DB_IDLE_TIMEOUT=30000
DB_STATEMENT_TIMEOUT=30000

ADMIN_EMAIL = 
ADMIN_PASSWORD = 


## email verification

# .env
SMTP_HOST=
SMTP_PORT= 
SMTP_USER=
SMTP_PASS=
SMTP_FROM=


# Redis
REDIS_HOST=  # for docker use redis (name of the service)   # Use 'redis' when running inside Docker
REDIS_PORT=